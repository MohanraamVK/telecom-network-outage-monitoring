# Copy to .env (same folder) for local runs from your IDE / mvnw.
# .env is git-ignored, so real passwords never get committed.
DB_URL=jdbc:mysql://localhost:3306/telecomdb?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=change-me
JWT_SECRET=replace-with-output-of-openssl-rand-base64-48
